{
  "manifest_version": 3,
  "name": "PHP Manual Language Switcher",
  "version": "2.0.0",
  "description": "Redirects PHP Manual pages to the Japanese version.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.php.net/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "128": "icon_128.png",
    "48": "icon_48.png",
    "16": "icon_16.png"
  },
  "action": {
    "default_icon": "icon_48.png",
    "default_title": "PHP Manual Language Switcher"
  }
}
